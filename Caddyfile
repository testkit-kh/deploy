{$DOMAIN}

encode gzip

handle /auth/* {
	reverse_proxy backend:8000
}

handle /api/* {
	reverse_proxy backend:8000
}

# BI под тем же доменом: iframe дашборда получается same-origin.
# Caddy срезает префикс /metabase — сам Metabase не умеет матчить свои
# внутренние роуты (/app/dist/*, /api/*) с префиксом, только генерит
# ссылки под него через MB_SITE_URL (base href и т.п.).
redir /metabase /metabase/ permanent

handle_path /metabase/* {
	reverse_proxy metabase:3000
}

handle /titiler/* {
	uri strip_prefix /titiler
	reverse_proxy titiler:8000
}

handle {
	reverse_proxy frontend:3000
}
