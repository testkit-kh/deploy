# --- Postgres ---
POSTGRES_USER=eco_project
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eco_project

# --- Backend ---
SECRET_KEY=change-me-to-a-random-secret-string
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=https://example.com

# --- ML (детекция мусора на отдельном хосте) ---
# DNS: ml.{DOMAIN} → IP машины с GPU; порт проброшен на роутере.
# На машине: uvicorn app.main:app --host 0.0.0.0 --port 8001 (+ TLS).
# ML_ENABLED=false или пустой ML_BASE_URL — /api/v1/ml/* отвечают 503,
# остальной API не падает.
ML_ENABLED=true
ML_BASE_URL=https://ml.example.com
ML_API_KEY=change-me-shared-with-ml-service
ML_TIMEOUT_S=180

# --- Titiler / Sentinel-2 (STAC) ---
# Публичный путь, по которому фронт тянет тайлы (через Caddy, без своего порта).
TITILER_PUBLIC_URL=https://example.com/titiler
STAC_API_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-l2a

# --- Frontend (SvelteKit adapter-node) ---
# Public URL the app is served at — required for CSRF/origin checks.
ORIGIN=https://example.com

# --- Reverse proxy (Caddy) ---
# A real domain here enables automatic HTTPS (Let's Encrypt).
# For IP-only / local deployment, use ":80" instead.
DOMAIN=example.com

# --- Metabase (BI, встроенный дашборд) ---
# Пароль read-only роли, которой Metabase ходит в схему kpi.
METABASE_RO_PASSWORD=change-me
# Хозяйственная БД самого Metabase (дашборды, вопросы, его пользователи).
METABASE_DB_NAME=metabase_app
METABASE_DB_USER=metabase_app
METABASE_DB_PASSWORD=change-me
# Общий секрет подписи embed-токенов: одинаковый у бэкенда и у Metabase.
# Сгенерировать: openssl rand -hex 32
METABASE_EMBEDDING_SECRET_KEY=change-me-to-a-random-64-hex-string
# Номера дашбордов печатает scripts/metabase_seed.py после провижининга.
# До первого прогона оставить нули — ручка embed вернёт 503, остальное живёт.
METABASE_DASHBOARD_FUNNEL=0
METABASE_DASHBOARD_OOPT=0
METABASE_DASHBOARD_IMPACT=0
