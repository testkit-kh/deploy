# --- Postgres ---
POSTGRES_USER=eco_project
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eco_project

# --- Backend ---
SECRET_KEY=change-me-to-a-random-secret-string
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=https://example.com

# --- Frontend (SvelteKit adapter-node) ---
# Public URL the app is served at — required for CSRF/origin checks.
ORIGIN=https://example.com

# --- Reverse proxy (Caddy) ---
# A real domain here enables automatic HTTPS (Let's Encrypt).
# For IP-only / local deployment, use ":80" instead.
DOMAIN=example.com
